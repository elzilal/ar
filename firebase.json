{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/login", "destination": "/login.html" },
      { "source": "/signup", "destination": "/signup.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/students", "destination": "/students.html" },
      { "source": "/server", "destination": "/elzilal-server.html" },
      { "source": "/upload-videos", "destination": "/upload-videos.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
